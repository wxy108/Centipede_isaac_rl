# Python build / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/

# Editable install metadata
*.dist-info/

# Pytest
.pytest_cache/
.coverage

# IDE / editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Training / experiment artifacts (regenerable, large)
outputs/
videos/
runs/
logs/
wandb/
*.log

# Data files (should be regenerable)
*.npz
*.npy
*.h5

# Large recorded media
*.mp4
*.avi
*.mov

# Stale backup files (git is the backup)
*.backup_*
*.bak
*.orig

# Local conda / venv
env/
venv/
.env

# Asset cache files (USD generated by convert_mjcf.py — keep the .usd
# committed since it's the deployment artifact, but ignore caches)
assets/.asset_hash

# Project-specific scratch
scratch/
notebooks/scratch*
